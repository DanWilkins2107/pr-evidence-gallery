# =============================================================================
# Private PR Evidence Gallery — web app / deploy configuration
# =============================================================================
# Copy this file to .env (repo root) and fill in the values.
# .env is already gitignored — it will never be committed.
#
# These values are the public Firebase web app config — NOT secrets.
# Firebase web config identifies the project but grants no access on its own.
# Security is enforced by Firebase Authentication + Security Rules.
#
# Where to get these values:
#   Firebase console → Project settings → "Your apps" → Web app config snippet.
#   If you haven't added a Web app yet, click "Add app" → Web, register it,
#   then copy the firebaseConfig object shown by the console.
#
# These values are consumed by scripts/generate-firebase-config.mjs, which
# writes public/firebase-config.js. That script runs automatically before every
# deploy (predeploy hook) and can be run manually with:
#   npm run config
#
# Note: the CLI bot has its own separate config in cli/.env (see cli/.env.example).
# =============================================================================

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
