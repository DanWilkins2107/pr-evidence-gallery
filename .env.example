# =============================================================================
# Private PR Evidence Gallery — single project configuration
# =============================================================================
# Copy this file to .env (repo root) and fill in the values.
# .env is already gitignored — it will never be committed.
#
# This ONE file is the single source of truth for both:
#   • the gallery website + deploy  (the six FIREBASE_* values)
#   • the upload CLI                (the same FIREBASE_* values + the bot section)
# so the Firebase config is never duplicated across two files.
#
#   - scripts/generate-firebase-config.mjs reads the FIREBASE_* values and writes
#     public/firebase-config.js (auto-runs before every deploy; or `npm run config`).
#   - the CLI (cli/) reads this same root .env for the FIREBASE_* values plus the
#     bot credentials and gallery URL below.
# =============================================================================

# --- Firebase web app config (used by BOTH the website and the CLI) ----------
# These values are the public Firebase web app config — NOT secrets. Firebase web
# config identifies the project but grants no access on its own; security is
# enforced by Firebase Authentication + Security Rules.
#
# Where to get them: Firebase console → Project settings → "Your apps" → Web app
# config snippet. If you haven't added a Web app yet, click "Add app" → Web,
# register it, then copy the firebaseConfig object shown by the console.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=

# --- CLI bot section (used ONLY by the upload CLI) ---------------------------
# BOT_EMAIL / BOT_PASSWORD: the dedicated bot account you created by hand in the
#   Firebase console (Authentication → Users). Unlike the FIREBASE_* values above,
#   BOT_PASSWORD IS a secret — keep this file gitignored and use a strong, unique
#   password. The bot is a normal Email/Password account constrained by Security
#   Rules (no admin access).
# GALLERY_BASE_URL: the hosted gallery URL, e.g. https://your-project.web.app —
#   used so `upload` can print the per-PR gallery link.
BOT_EMAIL=
BOT_PASSWORD=
GALLERY_BASE_URL=
