# =============================================================================
# Private PR Evidence Gallery — CLI configuration
# =============================================================================
# Copy this file to cli/.env and fill in the values.
# NEVER commit the real .env — it is gitignored and contains secrets.
#
# Where to get these values:
#   firebaseConfig values: Firebase console → Project settings → Your apps → Web app config
#   BOT_EMAIL / BOT_PASSWORD: The dedicated bot account you created by hand in the Firebase console
#   GALLERY_BASE_URL: The URL where the gallery is hosted (e.g. https://your-project.web.app)
# =============================================================================

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=
BOT_EMAIL=
BOT_PASSWORD=
GALLERY_BASE_URL=
