{
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/pr/**",
        "destination": "/pr.html"
      },
      {
        "source": "/login",
        "destination": "/login.html"
      }
    ]
  }
}
